# Safety net — pnpm-workspace.yaml has the authoritative minimumReleaseAge (4320 min = 3 days)
# This .npmrc value is a fallback if npm is ever invoked directly
minReleaseAge=3d

# Pin the Node used for pnpm scripts. better-sqlite3 11.10.0 does not compile
# against Node 26 (node-gyp fails building better_sqlite3.o), so this install
# runs Node 22 — which .nvmrc already declares but nothing enforced. Without
# this, `pnpm test` picks up whatever node is on PATH and every DB-touching
# test dies with "NODE_MODULE_VERSION 127. This version of Node.js requires
# NODE_MODULE_VERSION 147". pnpm fetches and caches the pinned version itself.
use-node-version=22.23.1
